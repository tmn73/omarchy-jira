#!/usr/bin/env bash
# Connects this machine to a Jira site, once.
#
# The API token goes into the system keyring and nowhere else. It is never
# written to a file, never exported, never logged, and never passed as a command
# line argument, since anything in argv is readable by every process on the
# machine through ps. Credentials reach curl through a config file supplied on a
# pipe instead.
#
# The site and the account email are not secrets, but they are stored as
# attributes of the same keyring entry so the credential stays a single object
# with a single writer. Nothing has to be kept in sync with shell.json, and the
# plugin can never hold half a credential.
set -euo pipefail

readonly SERVICE="omarchy-jira"
readonly LABEL="Omarchy Jira"
readonly TOKEN_PAGE="https://id.atlassian.com/manage-profile/security/api-tokens"

# The validation response body can carry the account's display name, so it is
# removed on every exit path rather than left behind in the temp directory.
BODY_FILE=""
cleanup() {
  if [[ -n $BODY_FILE ]]; then
    rm -f "$BODY_FILE"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'USAGE'
Usage: omarchy-jira-auth [--status | --clear | --help]

Connect this machine to a Jira site. The API token is stored in the system
keyring and read from there at request time.

  (no arguments)  Interactive setup: site, account email, API token
  --status        Show the connected site and account, never the token
  --clear         Remove the stored credential
  --help          Show this message
USAGE
}

die() {
  echo "omarchy-jira-auth: $*" >&2
  exit 1
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 ||
    die "$1 is required but was not found on PATH"
}

# Accepts what people actually paste: a bare host, a full URL, a trailing slash,
# or a deep link copied from a browser tab.
normalize_site() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  printf '%s' "$value"
}

# The whole credential is stored as one JSON document under a single keyring
# entry, and read back with `secret-tool lookup`.
#
# The alternative, keeping the site and account as keyring attributes, looks
# tidier but cannot be read safely: `secret-tool search` prints the secret
# itself on stdout and the attributes on stderr, so reading the attributes means
# inviting the token into the script's output. `lookup` returns exactly what was
# asked for and nothing else.
credential_json() {
  secret-tool lookup service "$SERVICE" 2>/dev/null || true
}

# Reads one field from the credential. The document is piped rather than passed
# as an argument or a here-string: arguments are visible in ps, and bash backs
# here-strings with a temporary file, which would put the token on disk.
credential_field() {
  local name="$1" json="$2"
  [[ -n $json ]] || return 0
  printf '%s' "$json" | jq -r --arg name "$name" '.[$name] // empty' 2>/dev/null || true
}

cmd_status() {
  require_tool secret-tool
  require_tool jq
  local json
  json=$(credential_json)
  if [[ -z $json ]]; then
    echo "Not connected. Run omarchy-jira-auth to connect a Jira site." >&2
    return 1
  fi
  echo "Connected to $(credential_field site "$json") as $(credential_field account "$json")"
}

cmd_clear() {
  require_tool secret-tool
  secret-tool clear service "$SERVICE"
  echo "Credential removed."
}

# Every Jira site publishes its cloud id without authentication. Scoped API
# tokens, which is what Atlassian issues today, are only accepted against
# api.atlassian.com/ex/jira/<cloudId>, never against the site host, so this
# lookup is what makes a freshly created token work at all.
discover_cloud_id() {
  local site="$1"
  curl --silent --max-time 10 \
    --header 'Accept: application/json' \
    --url "https://$site/_edge/tenant_info" 2>/dev/null |
    jq -r '.cloudId // empty' 2>/dev/null || true
}

# Validates the credential against one base URL before anything is stored, so a
# typo never leaves a broken credential in the keyring for the widget to trip
# over later. Returns the HTTP status on stdout.
validate_credential() {
  local base="$1" email="$2" token="$3" body_file="$4"
  curl --silent --show-error \
    --config <(printf 'user = "%s:%s"\n' "$email" "$token") \
    --header 'Accept: application/json' \
    --output "$body_file" \
    --write-out '%{http_code}' \
    --url "$base/rest/api/3/myself"
}

cmd_setup() {
  require_tool curl
  require_tool secret-tool
  require_tool jq

  local site email token
  read -r -p "Jira site (for example your-team.atlassian.net): " site
  site=$(normalize_site "${site:-}")
  [[ -n $site ]] || die "a site is required"

  read -r -p "Account email: " email
  [[ -n ${email:-} ]] || die "an account email is required"

  echo "Create an API token at $TOKEN_PAGE"
  read -r -s -p "API token (input hidden): " token
  echo
  [[ -n ${token:-} ]] || die "an API token is required"

  # Two kinds of API token are in circulation and they accept different hosts.
  # Rather than asking the user which one they hold, which they have no way of
  # knowing, try the modern base first and fall back to the site itself.
  local cloud_id candidates=() base accepted_base="" status http_code last_code=""
  cloud_id=$(discover_cloud_id "$site")
  [[ -n $cloud_id ]] && candidates+=("https://api.atlassian.com/ex/jira/$cloud_id")
  candidates+=("https://$site")

  BODY_FILE=$(mktemp)

  for base in "${candidates[@]}"; do
    status=0
    http_code=$(validate_credential "$base" "$email" "$token" "$BODY_FILE") || status=$?

    if ((status != 0)); then
      last_code="unreachable"
      continue
    fi

    case "$http_code" in
    200)
      accepted_base="$base"
      break
      ;;
    401 | 403 | 404)
      last_code="$http_code"
      ;;
    *)
      last_code="$http_code"
      ;;
    esac
  done

  if [[ -z $accepted_base ]]; then
    case "$last_code" in
    unreachable)
      die "could not reach https://$site, so nothing was stored"
      ;;
    401)
      die "Jira rejected that email and token, so nothing was stored"
      ;;
    403)
      die "that account is authenticated but not permitted to read the API, so nothing was stored"
      ;;
    404)
      die "https://$site does not look like a Jira site, so nothing was stored"
      ;;
    *)
      die "Jira answered $last_code, so nothing was stored"
      ;;
    esac
  fi

  # jq builds the document so a token containing a quote or a backslash cannot
  # produce malformed JSON, and the result is piped straight into the keyring
  # without ever touching a file or an argument.
  jq -nc --arg site "$site" --arg account "$email" --arg base "$accepted_base" \
    --rawfile token <(printf '%s' "$token") \
    '{site: $site, account: $account, base: $base, token: ($token | rtrimstr("\n"))}' |
    secret-tool store --label="$LABEL" service "$SERVICE" account "$email"

  local display_name=""
  if command -v jq >/dev/null 2>&1; then
    display_name=$(jq -r '.displayName // empty' <"$BODY_FILE" 2>/dev/null || true)
  fi

  if [[ -n $display_name ]]; then
    echo "Connected to $site as $display_name."
  else
    echo "Connected to $site as $email."
  fi
  echo "The token is in your system keyring. It is not stored anywhere else."
}

main() {
  case "${1:-}" in
  --status) cmd_status ;;
  --clear) cmd_clear ;;
  -h | --help) usage ;;
  "") cmd_setup ;;
  *) die "unknown option: $1" ;;
  esac
}

main "$@"
