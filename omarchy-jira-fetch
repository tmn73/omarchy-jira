#!/usr/bin/env bash
# Fetches the Jira work assigned to the connected account and prints one JSON
# document on stdout.
#
# Two rules govern this file.
#
# It always exits zero for anything the user can encounter: no credential, a
# locked keyring, an expired token, an unreachable network. Those are states of
# the world, not crashes, and each one is described in the payload so the panel
# can render a specific message instead of guessing from an exit code. A non
# zero exit means the helper itself is broken.
#
# It never keys off a status name. Every Jira site names its statuses freely, so
# the only portable signal is the status category, which Jira guarantees to be
# one of new, indeterminate, or done.
set -euo pipefail

readonly SERVICE="omarchy-jira"
readonly SCHEMA_VERSION=1
readonly DEFAULT_MAX=100

mode="dashboard"
search_query=""
matched_keys=""
want_sprint=0
projects_filter=""
max_results="$DEFAULT_MAX"

SEARCH_FILE=""
PROJECTS_FILE=""
cleanup() {
  [[ -n $SEARCH_FILE ]] && rm -f "$SEARCH_FILE"
  [[ -n $PROJECTS_FILE ]] && rm -f "$PROJECTS_FILE"
  return 0
}
trap cleanup EXIT

usage() {
  cat <<'USAGE'
Usage: omarchy-jira-fetch [--projects KEY[,KEY...]] [--max N]
       omarchy-jira-fetch --search QUERY

Prints one JSON document describing the tickets assigned to the connected
account, or the tickets matching a search. Run omarchy-jira-auth first to
connect a site.

  --projects  Restrict the dashboard to these project keys
  --search    Search the whole site by issue key or summary
  --sprint    Also report the active sprint and its progress
  --max       Maximum tickets to request, 1 to 100 (default 100)
  --help      Show this message
USAGE
}

# Emits a terminal payload and stops. Every field the panel binds to is present
# in every state, so the QML side never has to test for existence.
emit() {
  local state="$1" message="$2" site="${3:-}" account="${4:-}"
  jq -n \
    --argjson schema "$SCHEMA_VERSION" \
    --arg mode "$mode" \
    --arg state "$state" \
    --arg message "$message" \
    --arg site "$site" \
    --arg account "$account" \
    '{
      schema: $schema,
      mode: $mode,
      generatedAt: (now | todate),
      state: $state,
      message: $message,
      site: $site,
      account: $account,
      tickets: [],
      projects: [],
      sprint: null,
      sprintState: "off"
    }'
  exit 0
}

# The successful-but-empty payload. Kept separate from emit() so that an empty
# result never has to borrow an error state to say "nothing here".
emit_results() {
  local site="$2" account="$3"
  jq -n \
    --argjson schema "$SCHEMA_VERSION" \
    --arg mode "$mode" \
    --arg site "$site" \
    --arg account "$account" \
    '{
      schema: $schema,
      mode: $mode,
      generatedAt: (now | todate),
      state: "ok",
      message: "",
      site: $site,
      account: $account,
      tickets: [],
      projects: [],
      sprint: null,
      sprintState: "off"
    }'
  exit 0
}

# A project key is uppercase letters and digits starting with a letter. Anything
# else is dropped rather than escaped, because a key is not free text and a
# malformed one has no business reaching a JQL clause.
sanitize_projects() {
  local raw="$1" key cleaned=()
  raw="${raw//,/ }"
  for key in $raw; do
    if [[ $key =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
      cleaned+=("${key^^}")
    fi
  done
  local IFS=,
  printf '%s' "${cleaned[*]-}"
}

build_jql() {
  local clause="assignee = currentUser() AND statusCategory != Done"
  if [[ -n $projects_filter ]]; then
    clause="$clause AND project IN ($projects_filter)"
  fi
  printf '%s ORDER BY updated DESC' "$clause"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "${value%"${value##*[![:space:]]}"}"
}

# Search deliberately ignores the project filter. Someone pasting a key from
# chat needs it to open whether or not they follow that project day to day.
#
# The query goes to Jira's issue picker, which is what the search box in Jira
# itself uses. That is the only endpoint that resolves a bare number: typing
# 1069 has to find DS-1069 without this widget guessing the project, and no JQL
# expression can express that. currentJQL is required, since without it the
# picker only offers issues the user has recently viewed.
#
# The typed query therefore never becomes part of a JQL string. What comes back
# is a list of issue keys, each validated here before it is used, so the JQL
# this helper sends is built entirely from values it produced itself.
PICKER_FILE=""
MATCHED_KEYS=""
search_keys() {
  local query="$1" status=0 http_code key
  PICKER_FILE=$(mktemp)

  # currentJQL both enables the server side search and bounds it. Narrowing it
  # to the followed projects means an unfollowed project is never offered in the
  # first place, rather than being fetched and then hidden.
  local scope="order by created DESC"
  if [[ -n $projects_filter ]]; then
    scope="project IN ($projects_filter) order by created DESC"
  fi

  status=0
  http_code=$(api_request "$account" "$token" "$base/rest/api/3/issue/picker" "$PICKER_FILE" \
    --get --data-urlencode "query=$query" --data-urlencode "currentJQL=$scope") || status=$?

  if ((status != 0)); then
    rm -f "$PICKER_FILE"
    emit "network-error" "Could not reach $site." "$site" "$account"
  fi

  case "$http_code" in
  200) ;;
  401)
    rm -f "$PICKER_FILE"
    emit "unauthorized" "Jira rejected the stored token. Run omarchy-jira-auth to reconnect." "$site" "$account"
    ;;
  403)
    rm -f "$PICKER_FILE"
    emit "forbidden" "This account is not permitted to search those issues." "$site" "$account"
    ;;
  *)
    rm -f "$PICKER_FILE"
    emit "error" "Jira answered $http_code." "$site" "$account"
    ;;
  esac

  # The picker ranks by relevance and repeats an issue across its sections, so
  # deduplication has to keep first occurrence rather than sort, which is why it
  # happens here instead of through jq's `unique`.
  local keys=()
  local -A seen=()
  while IFS= read -r key; do
    [[ $key =~ ^[A-Za-z][A-Za-z0-9_]*-[0-9]+$ ]] || continue
    key="${key^^}"
    [[ -n ${seen[$key]:-} ]] && continue
    seen[$key]=1
    keys+=("$key")
  done < <(jq -r '.sections[]?.issues[]?.key // empty' <"$PICKER_FILE" 2>/dev/null || true)

  rm -f "$PICKER_FILE"
  PICKER_FILE=""

  local IFS=,
  MATCHED_KEYS="${keys[*]-}"
}

# Finds the story point fields.
#
# Sites commonly define more than one, "Story Points" and "Story point
# estimate" being the usual pair, and fill only one of them. Picking the first
# match would report zero points on a sprint that is fully estimated, so every
# candidate is collected and each ticket contributes its first non null value.
POINTS_FIELDS="[]"
SPRINT_FIELD=""
FIELDS_DISCOVERED=0
discover_fields() {
  ((FIELDS_DISCOVERED == 0)) || return 0
  FIELDS_DISCOVERED=1
  local file status=0 http_code
  file=$(mktemp)

  http_code=$(api_request "$account" "$token" "$base/rest/api/3/field" "$file") || status=$?
  if ((status != 0)) || [[ $http_code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$file"; then
    rm -f "$file"
    return 0
  fi

  POINTS_FIELDS=$(jq -c '[.[] | select((.name // "") | ascii_downcase | test("story point")) | .id] | .[0:4]' <"$file")
  [[ -n $POINTS_FIELDS ]] || POINTS_FIELDS="[]"

  # The sprint field carries the Greenhopper schema on every site, which is a
  # steadier signal than its display name.
  SPRINT_FIELD=$(jq -r 'map(select((.schema.custom // "") | test("gh-sprint"))) | .[0].id // empty' <"$file")
  if [[ -z $SPRINT_FIELD ]]; then
    SPRINT_FIELD=$(jq -r 'map(select((.name // "") == "Sprint")) | .[0].id // empty' <"$file")
  fi
  rm -f "$file"
}

# Reads the active sprint through the Agile API.
#
# This asks the board rather than inferring the sprint from the tickets. It
# costs extra token scopes, but a sprint that has just opened, before anything
# has been pulled into it, is exactly the one worth seeing, and inference cannot
# show it.
#
# SPRINT_STATE explains an absent sprint so the panel can distinguish "you have
# not picked a project" from "your token cannot read boards" from "there is no
# sprint running", which are three different things to do about it.
SPRINT_JSON="null"
SPRINT_STATE="off"

# Performs one Agile GET and leaves the body in AGILE_FILE. Returns the HTTP
# status in AGILE_CODE, or 0 for a transport failure.
AGILE_FILE=""
AGILE_CODE=""
agile_get() {
  local path="$1" status=0
  AGILE_FILE=$(mktemp)
  AGILE_CODE=$(api_request "$account" "$token" "$base$path" "$AGILE_FILE") || status=$?
  if ((status != 0)); then
    AGILE_CODE="0"
  fi
}

# Reads the active sprint from the tickets themselves.
#
# Every ticket carries the sprints it belongs to, so the active one can be
# recovered without board access. The limit is real: a sprint holding no ticket
# in the selected project is invisible this way, and so is one whose tickets the
# user cannot see. It is a fallback for tokens without Jira Software scopes, not
# a replacement.
fetch_sprint_from_issues() {
  local file status=0 http_code jql body fields

  discover_fields
  if [[ -z $SPRINT_FIELD ]]; then
    SPRINT_STATE="forbidden"
    return 0
  fi

  file=$(mktemp)
  jql="project IN ($projects_filter) AND sprint in openSprints()"
  fields=$(printf '%s' "$POINTS_FIELDS" | jq -c --arg sprint "$SPRINT_FIELD" '["status", $sprint] + .')
  body=$(jq -nc --arg jql "$jql" --argjson fields "$fields" '{jql: $jql, maxResults: 200, fields: $fields}')

  http_code=$(api_request "$account" "$token" "$base/rest/api/3/search/jql" "$file" \
    --header 'Content-Type: application/json' --request POST --data "$body") || status=$?

  if ((status != 0)) || [[ $http_code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$file"; then
    rm -f "$file"
    SPRINT_STATE="forbidden"
    return 0
  fi

  SPRINT_JSON=$(jq -c --arg sprint "$SPRINT_FIELD" --argjson points "$POINTS_FIELDS" '
    [.issues[]? | . as $issue
      | (($issue.fields[$sprint] // []) | map(select(.state == "active")) | .[0]) as $active
      | select($active != null)
      | {
          sprint: $active,
          status: ($issue.fields.status.name // ""),
          category: ($issue.fields.status.statusCategory.key // ""),
          estimate: ([$points[] | $issue.fields[.]] | map(select(. != null)) | .[0])
        }
    ] as $rows
    | if ($rows | length) == 0 then null else
        ($rows[0].sprint) as $s
        | {
            name: ($s.name // ""), goal: ($s.goal // ""),
            startDate: ($s.startDate // ""), endDate: ($s.endDate // ""),
            total: ($rows | length),
            estimated: ([$rows[] | select(.estimate != null)] | length),
            statuses: (
              $rows
              | group_by(.status)
              | map({
                  name: .[0].status,
                  category: .[0].category,
                  count: length,
                  points: ([.[] | .estimate // 0] | add // 0)
                })
              | sort_by(-.count)
            )
          }
      end' <"$file")
  rm -f "$file"

  if [[ -z $SPRINT_JSON || $SPRINT_JSON == "null" ]]; then
    SPRINT_JSON="null"
    SPRINT_STATE="none"
  else
    SPRINT_STATE="derived"
  fi
}

fetch_sprint() {
  local board_id sprint_id sprint_meta

  # Without a chosen project there is no board to read, and picking one for the
  # user would be guessing which team they care about.
  if [[ -z $projects_filter ]]; then
    SPRINT_STATE="no-project"
    return 0
  fi

  local project="${projects_filter%%,*}"

  agile_get "/rest/agile/1.0/board?projectKeyOrId=$project&maxResults=50"
  if [[ $AGILE_CODE == 401 || $AGILE_CODE == 403 ]]; then
    rm -f "$AGILE_FILE"
    # The Agile API needs Jira Software scopes that a plain Jira token does not
    # carry. Rather than showing nothing, fall back to reading the sprint off
    # the tickets, which any read:jira-work token can do. It cannot see a sprint
    # that holds no ticket, which is why it is the fallback and not the default.
    fetch_sprint_from_issues
    return 0
  fi
  if [[ $AGILE_CODE != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$AGILE_FILE"; then
    rm -f "$AGILE_FILE"
    SPRINT_STATE="unavailable"
    return 0
  fi

  # Kanban boards have no sprints, so a scrum board is preferred when a project
  # has both.
  board_id=$(jq -r '(.values // []) | (map(select(.type == "scrum")) + .) | .[0].id // empty' <"$AGILE_FILE")
  rm -f "$AGILE_FILE"
  if [[ -z $board_id ]]; then
    SPRINT_STATE="no-board"
    return 0
  fi

  agile_get "/rest/agile/1.0/board/$board_id/sprint?state=active&maxResults=50"
  if [[ $AGILE_CODE == 401 || $AGILE_CODE == 403 ]]; then
    rm -f "$AGILE_FILE"
    fetch_sprint_from_issues
    return 0
  fi
  if [[ $AGILE_CODE != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$AGILE_FILE"; then
    rm -f "$AGILE_FILE"
    SPRINT_STATE="unavailable"
    return 0
  fi

  sprint_meta=$(jq -c '(.values // []) | .[0] // empty' <"$AGILE_FILE")
  rm -f "$AGILE_FILE"
  if [[ -z $sprint_meta ]]; then
    SPRINT_STATE="none"
    return 0
  fi

  sprint_id=$(printf '%s' "$sprint_meta" | jq -r '.id // empty')
  if [[ -z $sprint_id ]]; then
    SPRINT_STATE="none"
    return 0
  fi

  discover_fields

  local fields
  fields=$(printf '%s' "$POINTS_FIELDS" | jq -r '["status"] + . | join(",")')

  agile_get "/rest/agile/1.0/board/$board_id/sprint/$sprint_id/issue?maxResults=200&fields=$fields"
  if [[ $AGILE_CODE != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$AGILE_FILE"; then
    rm -f "$AGILE_FILE"
    # The sprint exists and its dates are worth showing even when its contents
    # could not be counted.
    SPRINT_JSON=$(printf '%s' "$sprint_meta" | jq -c '{
      name: (.name // ""), goal: (.goal // ""),
      startDate: (.startDate // ""), endDate: (.endDate // ""),
      total: 0, estimated: 0, statuses: []
    }')
    SPRINT_STATE="partial"
    return 0
  fi

  SPRINT_JSON=$(jq -c \
    --argjson meta "$sprint_meta" \
    --argjson points "$POINTS_FIELDS" \
    '
    [.issues[]? | . as $issue | {
      status: ($issue.fields.status.name // ""),
      category: ($issue.fields.status.statusCategory.key // ""),
      estimate: ([$points[] | $issue.fields[.]] | map(select(. != null)) | .[0])
    }] as $rows
    | {
        name: ($meta.name // ""),
        goal: ($meta.goal // ""),
        startDate: ($meta.startDate // ""),
        endDate: ($meta.endDate // ""),
        total: ($rows | length),
        estimated: ([$rows[] | select(.estimate != null)] | length),
        statuses: (
          $rows
          | group_by(.status)
          | map({
              name: .[0].status,
              category: .[0].category,
              count: length,
              points: ([.[] | .estimate // 0] | add // 0)
            })
          | sort_by(-.count)
        )
      }
    ' <"$AGILE_FILE")
  rm -f "$AGILE_FILE"
  [[ -n $SPRINT_JSON ]] || SPRINT_JSON="null"
  SPRINT_STATE="ok"
}

# Performs one authenticated request and writes the body to a file. The
# credentials go through a config file on a pipe, never through an argument,
# since anything in argv is readable by every process on this machine.
# Prints the HTTP status on stdout.
api_request() {
  local account="$1" token="$2" url="$3" out="$4"
  shift 4
  curl --silent --show-error --max-time 20 \
    --config <(printf 'user = "%s:%s"\n' "$account" "$token") \
    --header 'Accept: application/json' \
    --output "$out" \
    --write-out '%{http_code}' \
    --url "$url" \
    "$@"
}

# Reads the credential into CREDENTIAL and reports what happened in
# CREDENTIAL_STATE.
#
# It writes to globals rather than printing, because emit() ends the process and
# a function whose output is captured with $(...) runs in a subshell, where exit
# only ends that subshell. A terminal state raised from inside a substitution
# would be swallowed into a variable and the script would carry on with a broken
# credential.
CREDENTIAL=""
CREDENTIAL_STATE="ok"
read_credential() {
  local stderr_file status
  stderr_file=$(mktemp)
  status=0
  CREDENTIAL=$(secret-tool lookup service "$SERVICE" 2>"$stderr_file") || status=$?

  if ((status != 0)); then
    # Both a missing entry and an unreachable keyring exit 1, but only the
    # second one explains itself on stderr. That is the only signal available,
    # and telling them apart is what lets the panel say something true.
    if [[ -s $stderr_file ]]; then
      CREDENTIAL_STATE="keyring-unavailable"
    else
      CREDENTIAL_STATE="unconfigured"
    fi
  elif [[ -z $CREDENTIAL ]]; then
    CREDENTIAL_STATE="unconfigured"
  fi

  rm -f "$stderr_file"
}

field() {
  local name="$1" json="$2"
  printf '%s' "$json" | jq -r --arg name "$name" '.[$name] // empty'
}

while (($# > 0)); do
  case "$1" in
  --projects)
    projects_filter=$(sanitize_projects "${2:-}")
    shift 2
    ;;
  --search)
    mode="search"
    search_query="${2:-}"
    shift 2
    ;;
  --sprint)
    want_sprint=1
    shift
    ;;
  --max)
    max_results="${2:-$DEFAULT_MAX}"
    [[ $max_results =~ ^[0-9]+$ ]] || {
      echo "omarchy-jira-fetch: --max must be a number" >&2
      exit 2
    }
    ((max_results < 1)) && max_results=1
    ((max_results > 100)) && max_results=100
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "omarchy-jira-fetch: unknown option: $1" >&2
    exit 2
    ;;
  esac
done

for tool in curl jq; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "omarchy-jira-fetch: $tool is required but was not found on PATH" >&2
    exit 2
  }
done

command -v secret-tool >/dev/null 2>&1 ||
  emit "keyring-unavailable" "secret-tool was not found. Install libsecret to store the Jira token."

read_credential
case "$CREDENTIAL_STATE" in
keyring-unavailable)
  emit "keyring-unavailable" "The system keyring did not answer. Check that gnome-keyring is running."
  ;;
unconfigured)
  emit "unconfigured" "Not connected to Jira. Run omarchy-jira-auth to connect a site."
  ;;
esac

site=$(field site "$CREDENTIAL")
account=$(field account "$CREDENTIAL")
base=$(field base "$CREDENTIAL")
token=$(field token "$CREDENTIAL")

if [[ -z $site || -z $account || -z $base || -z $token ]]; then
  emit "unconfigured" "The stored Jira credential is incomplete. Run omarchy-jira-auth again."
fi

SEARCH_FILE=$(mktemp)
if [[ $mode == "search" ]]; then
  trimmed_query=$(trim "$search_query")
  # A blank query is not a search, and must not cost a round trip.
  if [[ -z $trimmed_query ]]; then
    emit_results "" "$site" "$account"
  fi

  # Called plainly, never in a substitution: search_keys can raise a terminal
  # state, and exit inside $(...) would only end the subshell.
  search_keys "$trimmed_query"
  matched_keys="$MATCHED_KEYS"
  # Nothing matched. Asking for the details of an empty key list would be both
  # wasteful and invalid JQL.
  if [[ -z $matched_keys ]]; then
    emit_results "" "$site" "$account"
  fi

  jql="key IN ($matched_keys)"
else
  jql=$(build_jql)
fi
search_body=$(jq -nc --arg jql "$jql" --argjson max "$max_results" \
  '{jql: $jql, maxResults: $max, fields: ["summary","status","issuetype","project","updated"]}')

status=0
http_code=$(api_request "$account" "$token" "$base/rest/api/3/search/jql" "$SEARCH_FILE" \
  --header 'Content-Type: application/json' --request POST --data "$search_body") || status=$?

if ((status != 0)); then
  emit "network-error" "Could not reach $site." "$site" "$account"
fi

# A search for a key that does not exist makes Jira reject the JQL outright.
# To the person typing, that is simply no result, so it is not an error state.
if [[ $mode == "search" && $http_code == 400 ]]; then
  printf '{"issues":[]}' >"$SEARCH_FILE"
  http_code=200
fi

case "$http_code" in
200) ;;
401)
  emit "unauthorized" "Jira rejected the stored token. Run omarchy-jira-auth to reconnect." "$site" "$account"
  ;;
403)
  emit "forbidden" "This account is not permitted to read those issues." "$site" "$account"
  ;;
*)
  emit "error" "Jira answered $http_code." "$site" "$account"
  ;;
esac

jq -e . >/dev/null 2>&1 <"$SEARCH_FILE" ||
  emit "error" "Jira returned a response this plugin could not read." "$site" "$account"

# The project list is a convenience for the settings pane. Losing it must never
# cost the tickets, so it is fetched last and its failure is silent.
PROJECTS_FILE=$(mktemp)
printf '{"values":[]}' >"$PROJECTS_FILE"
projects_status=0
if [[ $mode != "search" && $want_sprint == 1 ]]; then
  fetch_sprint
fi

if [[ $mode != "search" ]]; then
  projects_code=$(api_request "$account" "$token" \
    "$base/rest/api/3/project/search?maxResults=50" "$PROJECTS_FILE") || projects_status=$?

  if ((projects_status != 0)) || [[ $projects_code != 200 ]] ||
    ! jq -e . >/dev/null 2>&1 <"$PROJECTS_FILE"; then
    printf '{"values":[]}' >"$PROJECTS_FILE"
  fi
fi

# The picker's ranking, as JSON, or an empty list outside search mode.
order_json='[]'
if [[ -n $matched_keys ]]; then
  order_json=$(printf '%s' "$matched_keys" | jq -R 'split(",")')
fi

jq -n \
  --argjson schema "$SCHEMA_VERSION" \
  --arg mode "$mode" \
  --arg site "$site" \
  --arg account "$account" \
  --slurpfile search "$SEARCH_FILE" \
  --slurpfile projects "$PROJECTS_FILE" \
  --argjson order "$order_json" \
  --argjson sprint "$SPRINT_JSON" \
  --arg sprintState "$SPRINT_STATE" \
  '{
    schema: $schema,
    mode: $mode,
    generatedAt: (now | todate),
    state: "ok",
    message: "",
    site: $site,
    account: $account,
    tickets: [
      ($search[0].issues // [])[]
      | select($mode == "search" or .fields.status.statusCategory.key != "done")
      | {
          key: .key,
          summary: (.fields.summary // ""),
          type: (.fields.issuetype.name // ""),
          status: (.fields.status.name // ""),
          statusCategory: (.fields.status.statusCategory.key // "new"),
          projectKey: (.fields.project.key // ""),
          projectName: (.fields.project.name // ""),
          updated: (.fields.updated // ""),
          url: "https://\($site)/browse/\(.key)"
        }
    ],
    projects: [
      ($projects[0].values // [])[]
      | { key: .key, name: (.name // .key) }
    ],
    sprint: $sprint,
    sprintState: $sprintState
  }
  # Jira returns matched issues in its own order, but the picker ranked them by
  # relevance, and that ranking is the useful one for a search box.
  | if $order == [] then . else
      .tickets |= sort_by(.key as $k | ($order | index($k)) // 9999)
    end'
